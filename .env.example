# Fall Detection System - Environment Variables Template
# 复制此文件为 .env 并填写实际值

# ==================== 应用配置 ====================
APP_NAME="Fall Detection System"
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ==================== 数据库配置 ====================
DATABASE_URL="sqlite:///data/database.db"
# PostgreSQL: postgresql://user:password@localhost:5432/fall_detection
# MySQL: mysql://user:password@localhost:3306/fall_detection

# ==================== 认证配置 ====================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=30

# 默认管理员账户（首次启动时创建）
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="admin123"
DEFAULT_ADMIN_EMAIL="admin@example.com"

# ==================== 摄像头配置 ====================
CAMERA_DEFAULT_FPS=30
CAMERA_MAX_CAMERAS=16
CAMERA_RECONNECT_INTERVAL=30

# ==================== 通知配置 ====================
NOTIFICATION_ENABLED=true

# 微信推送（企业微信/公众号）
WECHAT_BOT_KEY=""
WECHAT_CORP_ID=""
WECHAT_AGENT_ID=""

# 短信通知
SMS_PROVIDER=tencent  # tencent, aliyun
SMS_API_KEY=""
SMS_PHONE_NUMBERS=""

# 邮件通知
SMTP_SERVER="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# 飞书推送
FEISHU_WEBHOOK_URL=""

# ==================== 存储配置 ====================
RECORDING_PATH="data/recordings"
EXPORT_PATH="data/exports"
CACHE_PATH="data/cache"
MAX_RECORDING_DAYS=7

# ==================== 检测算法配置 ====================
DETECTION_VOXEL_SIZE=0.05
DETECTION_HEIGHT_DROP_THRESHOLD=0.3
DETECTION_CONFIDENCE_THRESHOLD=0.7
DETECTION_INTERVAL_MS=100

# ==================== 监控配置 ====================
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60
ALERT_COOLDOWN_SECONDS=30

# ==================== 安全配置 ====================
CORS_ORIGINS=["http://localhost:8501", "http://43.134.43.119:8501"]
RATE_LIMIT_PER_MINUTE=60
ALLOWED_IPS=""  # 留空表示允许所有 IP

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8501
WORKERS=4
